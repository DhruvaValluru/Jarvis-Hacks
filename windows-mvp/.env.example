# Copy to .env (setup.bat does this) and paste your key from https://platform.claude.com
ANTHROPIC_API_KEY=
# Optional settings
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_EFFORT=low            (low = fastest replies; medium/high = more careful)
# JARVIS_WHISPER_MODEL=base.en (tiny.en = faster, small.en = more accurate)
# JARVIS_SPEAK=1               (0 = don't speak replies)
# JARVIS_COMPUTER_USE=1        (0 = never use screenshots + real mouse/keyboard)
# JARVIS_MAX_STEPS=40          (tool steps per request; 12 when computer use is off)

# Photon Spectrum project (project id is public; keep the secret local).
SPECTRUM_PROJECT_ID=908385d3-2f06-4c90-92d3-5937397eea69
SPECTRUM_PROJECT_SECRET=
# Telegram: create a dedicated bot with @BotFather /newbot.
TELEGRAM_BOT_TOKEN=
# Leave blank for discovery mode; /start prints your ID on the PC.
TELEGRAM_OWNER_ID=
# OpenAI voice-note transcription and spoken replies (text works without this key).
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=cedar
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional custom voice service. Overrides direct OpenAI transcription and speech.
# VOICE_SERVICE_URL=http://127.0.0.1:8000
# VOICE_SERVICE_TOKEN=

# Multiple PCs (see README "Use several PCs"). Run "jarvis.bat --serve" on a PC to get the token.
# JARVIS_TOKEN=                 (same secret on every PC; PCs with it find each other automatically)
# JARVIS_SERVE=1                (also let the other PCs use this one while you talk to it)
# JARVIS_NAME=desktop           (this PC's name; default = computer name)
# JARVIS_DEVICES=laptop=100.64.0.2:8765, computer-2=192.168.1.20   (only if discovery can't see them)
# JARVIS_DISCOVER=1             (0 = only use JARVIS_DEVICES)
# JARVIS_PORT=8765              (discovery uses UDP 8766)
